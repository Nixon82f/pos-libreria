# =====================================================================
# Variables de entorno de Supabase requeridas por Next.js
# =====================================================================
# Configúralas en tu archivo local .env.local y en:
# Vercel -> Project Settings -> Environment Variables
#
# Next.js requiere el prefijo NEXT_PUBLIC_ para exponerlas al navegador:
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-de-supabase

